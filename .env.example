# Copie para .env para uso local. Na nuvem, estas variáveis ficam no Render (veja render.yaml).

# local (padrão) ou producao. Em producao, a API recusa chaves e senhas de demonstração.
AMBIENTE=local

# Banco local: SQLite. Na nuvem: PostgreSQL (o Render preenche automaticamente).
DATABASE_URL=sqlite:///./moeda_estudantil.db
SECRET_KEY=troque-por-uma-chave-aleatoria-longa-em-producao
SESSION_HTTPS_ONLY=0

# Contas de demonstração. Localmente, a senha padrão é Demo@12345.
SEED_DEMO_PROFESSOR=1
SEED_DEMO_COMPLETO=0
# DEMO_SENHA=

# Crédito semestral e envio da fila de e-mails automáticos (LAB04S01). 0 desliga.
TAREFAS_AUTOMATICAS=1

# E-mail (opcional). Sem SMTP_HOST, as mensagens ficam pendentes no banco.
# Porta 465 usa SSL; 587 (ou 2525) usa STARTTLS.
# SMTP_HOST=smtp.exemplo.com
# SMTP_PORT=587
# SMTP_USER=usuario@exemplo.com
# SMTP_PASSWORD=senha-de-aplicativo
# SMTP_FROM=usuario@exemplo.com
